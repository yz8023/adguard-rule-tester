<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_sources" />

        <TextView
            android:id="@+id/tv_source_update_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/source_update_note"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/src1_label" />
            <TextView
                android:id="@+id/btn_copy_src1"
                style="@style/SourceLink"
                android:text="@string/copy_link_short" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_url1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:textSize="12sp" />

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/src2_label" />
            <TextView
                android:id="@+id/btn_copy_src2"
                style="@style/SourceLink"
                android:text="@string/copy_link_short" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_url2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:textSize="12sp" />

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/src3_label" />
            <TextView
                android:id="@+id/btn_copy_src3"
                style="@style/SourceLink"
                android:text="@string/copy_link_short" />
        </LinearLayout>

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/src4_label" />
            <TextView
                android:id="@+id/btn_copy_src4"
                style="@style/SourceLink"
                android:text="@string/copy_link_short" />
        </LinearLayout>

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/src5_label" />
            <TextView
                android:id="@+id/btn_copy_src5"
                style="@style/SourceLink"
                android:text="@string/copy_link_short" />
        </LinearLayout>

        <LinearLayout style="@style/SourceRow">
            <CheckBox
                android:id="@+id/cb_src_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/src_custom_label" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_url_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/src_custom_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_parse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_parse"
            android:textColor="@color/primary_button_text" />

        <TextView
            android:id="@+id/tv_parse_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_card"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_test" />

        <CheckBox
            android:id="@+id/cb_doh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:checked="true"
            android:padding="10dp"
            android:text="@string/cb_doh" />

        <CheckBox
            android:id="@+id/cb_oem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_glass_card"
            android:checked="true"
            android:padding="10dp"
            android:text="@string/cb_oem" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="@string/btn_start"
                android:textColor="@color/primary_button_text" />
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/chip_surface"
                android:enabled="false"
                android:text="@string/btn_stop"
                android:textColor="@color/primary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_results" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:padding="12dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_results"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_card"
            android:clipToPadding="false"
            android:padding="6dp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_rules" />

        <CheckBox
            android:id="@+id/cb_important"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:padding="8dp"
            android:text="@string/cb_important" />

        <CheckBox
            android:id="@+id/cb_unknown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass_card"
            android:padding="8dp"
            android:text="@string/cb_unknown" />

        <CheckBox
            android:id="@+id/cb_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass_card"
            android:checked="true"
            android:padding="8dp"
            android:text="@string/cb_group" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_generate"
            android:textColor="@color/primary_button_text" />

        <EditText
            android:id="@+id/et_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/chip_surface"
                android:text="@string/btn_copy"
                android:textColor="@color/primary" />
            <Button
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/chip_surface"
                android:text="@string/btn_share"
                android:textColor="@color/primary" />
            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/chip_surface"
                android:text="@string/btn_save"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_card"
            android:padding="12dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/help_text"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
